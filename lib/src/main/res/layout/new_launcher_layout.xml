<?xml version="1.0" encoding="UTF-8"?>
	<RelativeLayout
		xmlns:android="http://schemas.android.com/apk/res/android"
		xmlns:app="http://schemas.android.com/apk/res-auto"
		android:id = "@+id/launcher_window_content"
		android:layout_height = "match_parent"
		android:layout_width = "match_parent"
		android:fitsSystemWindows = "true">
	<ImageView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:scaleType="centerCrop"
		android:src="@drawable/background"
		android:importantForAccessibility="no"/>

	<androidx.appcompat.widget.Toolbar
		android:id="@+id/my_toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		android:background="?attr/colorPrimary"
		android:elevation="4dp"
		android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
		android:layout_alignParentTop = "true"
		app:popupTheme="@style/ThemeOverlay.AppCompat.Dark"/>
		

		
		<TextView
			android:text = "@string/label_connections"
			android:textSize = "20sp"
			android:layout_height = "wrap_content"
			android:layout_width = "300dip"
			android:id = "@+id/c_label"
			android:layout_alignParentEnd = "true"
			android:layout_below="@id/my_toolbar"
			android:gravity = "center"
			android:background = "#AAAAAAAA"
			android:textColor = "#AA222222"
			app:drawableBottomCompat="@drawable/horizontal_separator"
			/>
			
		<!-- <ImageView
			android:layout_width="275dp"
			android:layout_height="5dp"
			android:layout_below="@id/c_label"
			android:id="@+id/separator"
			src="@drawable/horizontal_separator"/> -->
			
		<LinearLayout
			android:id = "@+id/table_container"
			android:layout_height = "wrap_content"
			android:layout_width = "match_parent"
			android:layout_alignParentBottom = "true"
			android:orientation = "horizontal"
			android:background = "#EE222222"
			android:padding = "8dp"
			android:gravity = "center">
			<LinearLayout
				android:id="@+id/test_update"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:visibility="gone">
				<TextView android:id="@+id/update_label" android:text="@string/label_test_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textColor = "#AA222222" android:textStyle="bold"/>
				<Button android:text="@string/btn_update" android:id="@+id/update_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
			</LinearLayout>
			<Button
				android:id = "@+id/new_connection"
				android:layout_height = "48dp"
				android:layout_width = "0dp"
				android:layout_weight = "1"
				android:layout_marginEnd = "4dp"
				android:text = "@string/btn_new_bracket"
				android:textColor = "#FFFFFFFF"
				android:textSize = "14sp"
				android:textStyle = "bold"
				android:backgroundTint = "#FF555555"/>
			<Button
				android:id = "@+id/help_button"
				android:layout_height = "48dp"
				android:layout_width = "0dp"
				android:layout_weight = "1"
				android:layout_marginStart = "4dp"
				android:text = "@string/btn_help_bracket"
				android:textColor = "#FFFFFFFF"
				android:textSize = "14sp"
				android:textStyle = "bold"
				android:backgroundTint = "#FF555555"/>
		</LinearLayout>
		<FrameLayout
			android:id="@+id/timer_frame"
			android:layout_width = "300dip"
			android:layout_height="match_parent"
			android:layout_margin="0dip"
			android:padding="0dip"
			android:layout_alignParentEnd="true"
			android:layout_above="@id/table_container"
			android:layout_below="@id/c_label">	
		<ListView
			android:id = "@+id/connection_list"

			android:layout_height = "match_parent"
			android:layout_width = "300dip"
			android:divider= "#00000000">
			
		</ListView>
		<TextView
			android:id="@+id/launcher_empty"
			android:layout_width="300dip"
			android:layout_height="match_parent"
			android:text="@string/msg_no_connections"
			android:textColor="#AA222222"
			android:background="#AAAAAAAA"
			android:layout_margin="0dip"
			android:padding="0dip"
			android:textStyle="bold"
			android:textSize="18sp"
			android:gravity="center"/>
		</FrameLayout>

	
	</RelativeLayout>