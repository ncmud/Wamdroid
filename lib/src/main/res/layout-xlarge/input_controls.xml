<?xml version="1.0" encoding="UTF-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/input_ctrl_container"
    android:layout_width="300dip"
    android:layout_height="40dip"
    >
    
    <ImageButton
    	android:id="@+id/down_btn_c"
    	android:layout_width="100dip"
    	android:layout_height="40dip"
    	android:src="@drawable/prev_button"
    	android:background="#0A0A0A"
    	android:textSize="16sp"
    	android:typeface="monospace"
    	android:textColor="#9999FF"
    	android:text="@string/btn_down"
    	android:contentDescription="@string/cd_scroll_down"/>

    <ImageButton
    	android:id="@+id/up_btn_c"
    	android:layout_width="100dip"
    	android:layout_height="40dip"
    	android:background="#0A0A0A"
    	android:src="@drawable/next_button"
    	android:textSize="16sp"
    	android:typeface="monospace"
    	android:textColor="#9999FF"
    	android:text="@string/btn_up"
    	android:contentDescription="@string/cd_scroll_up"/>
    <ImageButton
    	android:id="@+id/enter_btn_c"
    	android:layout_width="100dip"
    	android:layout_height="40dip"
    	android:background="#0A0A0A"
    	android:src="@drawable/enter_button"
    	android:textSize="16sp"
    	android:typeface="monospace"
    	android:textColor="#9999FF"
    	android:text="@string/btn_enter"
    	android:contentDescription="@string/cd_send_input"/>
</LinearLayout>