<?xml version="1.0" encoding="UTF-8"?>

<RelativeLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/newtoastlayout"
  android:layout_width="350dip"
  android:layout_height="200dip">
  
  <TextView
		android:id="@+id/titlebar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_alignParentTop="true"
		android:text="TOAST RESPONDER"
		android:textColor="#FF333333"
		android:background="#FF999999"
		android:textSize="15sp"
		android:textStyle="bold"
		android:gravity="center"/>
  
    <Button
    	android:layout_width="100dip"
  		android:layout_height="wrap_content"
  		android:id="@+id/responder_toast_cancel"
  		android:layout_alignParentBottom="true"
  		android:layout_alignParentEnd="true"
  		android:text="Cancel" />
  
  <Button
  	android:layout_width="240dip"
  	android:layout_height="wrap_content"
  	android:text="Done"
  	android:id="@+id/responder_toast_done_button"
  	android:layout_toStartOf="@id/responder_notification_cancel"
  	android:layout_alignParentBottom="true"/>
  
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_above="@id/responder_toast_done_button" android:layout_below="@id/titlebar">
  <TableLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:shrinkColumns="0" android:stretchColumns="1">
  	<TableRow>
  		<TextView android:text="Message:"/>
  		<EditText android:id="@+id/responder_toast_message"/>
  	</TableRow>
  </TableLayout>
  <TableLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:shrinkColumns="1" android:stretchColumns="0">
  	<TableRow>
  		<TextView android:text="Show for (seconds):" android:gravity="end" android:layout_marginEnd="5dip"/>
  		<EditText android:id="@+id/responder_toast_delay" android:width="60dip"/>
  	</TableRow>
  </TableLayout>
  </LinearLayout>

  
</RelativeLayout>