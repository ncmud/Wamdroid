<?xml version="1.0" encoding="UTF-8"?>

<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/sw_row_layout"
  android:layout_width="300dip"
  android:layout_height="wrap_content"
  android:orientation="horizontal">

  	<TextView
  		android:layout_marginTop="7dip"
  		android:id="@+id/dir_str"
  		android:layout_width="0dip"
  		android:layout_height="35dip"
  		android:layout_weight="1"
  		android:textColor="#FFF7941D"
  		android:textSize="22sp"
  		android:gravity="center_horizontal|center_vertical"

			/>
  	<ImageButton
  		android:layout_marginTop="3dip"
  		android:id="@+id/dir_edit"
  		android:src="@drawable/edit_button"
  		android:contentDescription="@string/cd_edit_item"
  		/>
  	<ImageButton
  	android:layout_marginStart="3dip"
  	android:layout_marginTop="3dip"
  		android:id="@+id/dir_del"
  		android:src="@drawable/delete_button"
  		android:contentDescription="@string/cd_delete_item"/>

</LinearLayout>
