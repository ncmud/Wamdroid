<?xml version="1.0" encoding="UTF-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/button_properties_rl"
	android:layout_width = "300dip"
	android:layout_height = "250dip">
	
	<TextView
		android:id="@+id/titlebar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_alignParentTop="true"
		android:text="@string/title_modify_button"
		android:textColor="#FF333333"
		android:background="#FF999999"
		android:textSize="15sp"
		android:textStyle="bold"
		android:gravity="center"/>
	
	<Button
		android:id = "@+id/button_delete_btn"
		android:layout_width = "wrap_content"
		android:layout_height = "wrap_content"
		android:layout_alignParentBottom="true"
		android:layout_alignParentStart="true"
		android:text = "@string/btn_delete"/>
	<Button
		android:id = "@+id/button_done_btn"
		android:layout_width = "match_parent"
		android:layout_height = "wrap_content"
		android:layout_alignParentBottom="true"
		android:layout_toEndOf="@id/button_delete_btn"
		android:layout_alignTop="@id/button_delete_btn"
		android:text = "@string/btn_done_excl"/>
	
	<TabHost android:id="@+id/btn_editor_tabhost" android:layout_marginTop="3dip" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@id/button_delete_btn" android:layout_below="@id/titlebar">
		<TabWidget android:id="@android:id/tabs" android:layout_width="match_parent" android:layout_height="28sp"/>
		<FrameLayout android:id="@android:id/tabcontent" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="32sp">
		<!--	<TextView android:id="@+id/btn_editor_testtab1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TESTSTESTERT"/> -->
			<TableLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:id="@+id/btn_editor_tab1">
				<TableRow
					android:layout_width="wrap_content"
					android:layout_height="wrap_content">
						<TextView
							android:id="@+id/lbl_label"
							android:layout_width = "wrap_content"
							android:layout_height = "wrap_content"
							android:textSize="22sp"
							android:text = "@string/label_label"
							android:layout_alignParentTop = "true"
							android:layout_alignParentStart = "true"
							android:gravity = "end"/>
						<EditText
							android:id = "@+id/button_text_et"
							android:layout_width = "225dp"
							android:singleLine = "true"
							android:layout_height = "wrap_content"
							android:layout_toEndOf="@id/lbl_label"/>
				</TableRow>
			
				<TableRow		
				android:layout_width="300dp"
				android:layout_height="wrap_content">
					<TextView
					android:id="@+id/cmd_label"
					android:layout_width = "wrap_content"
					android:layout_height = "wrap_content"
					android:textSize="22sp"
					android:layout_below = "@id/lbl_label"
					android:layout_alignBottom = "@id/button_text_et"
					android:text = "@string/label_cmd"
					android:gravity = "end"/>
					<EditText
					android:id = "@+id/button_command_et"
					android:layout_width = "225dp"
					android:layout_height = "wrap_content"
					android:singleLine = "true"
					android:layout_toEndOf ="@id/cmd_label"
					android:layout_alignTop ="@id/cmd_label"/>	
				</TableRow>
			</TableLayout>
			<TableLayout android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/btn_editor_tab2">				
				<TableRow		
				android:layout_width="300dp"
				android:layout_height="wrap_content">
					<TextView
					android:id="@+id/flip_label_label"
					android:layout_width = "wrap_content"
					android:layout_height = "wrap_content"
					android:textSize="22sp"
					android:layout_below = "@id/cmd_label"
					android:layout_alignBottom = "@id/button_command_et"
					android:text = "@string/label_label"
					android:gravity = "end"/>
					<EditText
					android:id = "@+id/button_flip_label_et"
					android:layout_width = "225dp"
					android:layout_height = "wrap_content"
					android:singleLine = "true"
					android:layout_toEndOf ="@id/flip_label_label"
					android:layout_alignTop ="@id/flip_label_label"/>	
				</TableRow>

				<TableRow		
				android:layout_width="300dp"
				android:layout_height="wrap_content">
					<TextView
					android:id="@+id/flip_label"
					android:layout_width = "wrap_content"
					android:layout_height = "wrap_content"
					android:textSize="22sp"
					android:layout_below = "@id/cmd_label"
					android:layout_alignBottom = "@id/button_command_et"
					android:text = "@string/label_cmd"
					android:gravity = "end"/>
					<EditText
					android:id = "@+id/button_flip_et"
					android:layout_width = "225dp"
					android:layout_height = "wrap_content"
					android:singleLine = "true"
					android:layout_toEndOf ="@id/flip_label"
					android:layout_alignTop ="@id/flip_label"/>	
				</TableRow>	
			</TableLayout>
			
			<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btn_editor_tab3">
			<ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btn_editor_advanced_scroll_containter">
			<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="10sp">
			<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_movement_method" android:gravity="start" android:background="@drawable/movemethod_frame" android:layout_marginBottom="-3sp"/>
				
			<TableLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/movemethod_frame">
				
				
				<TableRow
					android:layout_span="3">
						<CheckBox
						android:id="@+id/move_free"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_gravity="center"/>
						<CheckBox
						android:id="@+id/move_nudge"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_gravity="center"/>
						<CheckBox
						android:id="@+id/move_freeze"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_gravity="center"/>
				</TableRow>
				<TableRow
				android:layout_span="3">
					<TextView
					android:layout_width="89dp"
					android:layout_height="wrap_content"
					android:gravity="center"
					android:text="@string/btn_mode_free"/>
					<TextView
					android:layout_width="89dp"
					android:layout_height="wrap_content"
					android:gravity="center"
					android:text="@string/btn_mode_nudge"/>
					<TextView
					android:layout_width="89dp"
					android:layout_height="wrap_content"
					android:text="@string/btn_mode_freeze"
					android:gravity="center"/>
				</TableRow>
				</TableLayout>
				
				<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_switch_to_button_set"  android:layout_marginTop="10sp" android:background="@drawable/movemethod_frame" android:layout_marginBottom="-3sp"/>
				<TableLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/movemethod_frame">
					<TableRow android:layout_marginTop="5dip">
						<EditText
							android:id="@+id/btn_editor_targetset_et"
							android:inputType="text"
							android:hint="@string/label_button_set_to_switch"
							/>
					</TableRow>
				</TableLayout>
				
				<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_button_colors"  android:layout_marginTop="10sp" android:background="@drawable/movemethod_frame" android:layout_marginBottom="-3sp"/>
				
				<TableLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/movemethod_frame" android:stretchColumns="*">
				
				
				<TableRow android:layout_width="match_parent" android:layout_marginTop="10sp" android:layout_height="30sp">
					<Button android:layout_marginStart="2sp" android:layout_marginEnd="2sp" android:id="@+id/btn_defaultcolor" android:background="#FF000000" android:layout_height="40sp"/>
					<Button android:layout_marginStart="2sp" android:layout_marginEnd="2sp" android:id="@+id/btn_focuscolor" android:background="#FF000000" android:layout_height="40sp"/>
					<Button android:layout_marginStart="2sp" android:layout_marginEnd="2sp" android:id="@+id/btn_flippedcolor" android:background="#FF000000" android:layout_height="40sp"/>
				</TableRow>
				<TableRow >
					<TextView  android:text="@string/label_normal" android:gravity="center"/>
					<TextView  android:text="@string/label_focused" android:gravity="center"/>
					<TextView  android:text="@string/label_flipped" android:gravity="center"/>
				</TableRow>
				
				<TableRow  android:layout_marginTop="10sp" >
					<Button android:layout_marginStart="2sp" android:layout_marginEnd="2sp" android:id="@+id/btn_labelcolor" android:background="#FF000000" android:layout_height="40sp"/>
					<Button android:layout_marginStart="2sp" android:layout_marginEnd="2sp" android:id="@+id/btn_fliplabelcolor" android:background="#FF000000" android:layout_height="40sp"/>
				</TableRow>
				<TableRow android:layout_span="3" >
					<TextView android:text="@string/label_label_text" android:gravity="center"/>
					<TextView android:text="@string/label_flip_label" android:gravity="center"/>
				</TableRow>
			</TableLayout>
			

			
			<TableLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10sp">
				<TableRow>
				<TableLayout android:layout_marginStart="5sp" android:layout_marginEnd="5sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/blue_frame_nomargin">
					<TableRow>
					<TextView android:text="@string/label_label_size" />
					</TableRow>
					<TableRow>
					<EditText android:id="@+id/btn_editor_lblsize_et" android:width="30sp" android:inputType="number" android:singleLine="true"/>
					</TableRow>
				</TableLayout>
				<TableLayout android:layout_marginStart="5sp" android:layout_marginEnd="5sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/blue_frame_nomargin">
					<TableRow>
					<TextView android:text="@string/label_x_coord" />
					</TableRow>
					<TableRow>
					<EditText android:id="@+id/btn_editor_xcoord_et" android:width="30sp" android:inputType="number" android:singleLine="true"/>
					</TableRow>
				</TableLayout>
				<TableLayout android:layout_marginStart="5sp" android:layout_marginEnd="5sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/blue_frame_nomargin">
					<TableRow>
					<TextView android:text="@string/label_y_coord" />
					</TableRow>
					<TableRow>
					<EditText android:id="@+id/btn_editor_ycoord_et" android:width="30sp" android:inputType="number" android:singleLine="true"/>
					</TableRow>
				</TableLayout>
				</TableRow>
				<TableRow>
				<TableLayout android:layout_marginTop="15sp" android:layout_marginStart="5sp" android:layout_marginEnd="5sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/blue_frame_nomargin">
					<TableRow>
					<TextView android:text="@string/label_width" android:layout_gravity="center" />
					</TableRow>
					<TableRow>
					<EditText android:id="@+id/btn_editor_width_et" android:width="30sp" android:inputType="number" android:singleLine="true"/>
					</TableRow>
				</TableLayout>
				<TableLayout android:layout_marginTop="15sp" android:layout_marginStart="5sp" android:layout_marginEnd="5sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/blue_frame_nomargin">
					<TableRow>
					<TextView android:text="@string/label_height" android:layout_gravity="center" />
					</TableRow>
					<TableRow>
					<EditText android:id="@+id/btn_editor_height_et" android:width="30sp" android:inputType="number" android:singleLine="true"/>
					</TableRow>
				</TableLayout>
				</TableRow>
			</TableLayout>
			<!-- <TableLayout android:stretchColumns="*" android:layout_marginTop="15sp" android:layout_marginStart="5sp" android:layout_marginEnd="5sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/blue_frame_nomargin" android:gravity="center_horizontal">
				<TableRow>
					<Button android:id="@+id/fit" android:text="@string/btn_fit_button_to_label" android:layout_marginTop="10dip" android:paddingStart="20dip" android:paddingEnd="20dip"/>
				</TableRow>
				<TableRow>
					<Button android:id="@+id/reset" android:text="@string/btn_reset_to_set_defaults" android:layout_marginTop="10dip" android:paddingStart="20dip" android:paddingEnd="20dip"/>
				</TableRow>
			</TableLayout> -->
			</LinearLayout>
			</ScrollView>
			</LinearLayout>
		</FrameLayout>
	</TabHost>
	
</RelativeLayout>